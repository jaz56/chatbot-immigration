# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Ne commitez jamais le fichier ".env" (il est dans .gitignore).

# Clé API Ollama Cloud (https://ollama.com) utilisée pour le function-calling du chatbot
OLLAMA_API_KEY=

# URI de connexion MongoDB (inclut identifiants, hôte, port, base d'authentification)
MONGO_URI=mongodb://<utilisateur>:<mot_de_passe>@localhost:27019/admin_db?authSource=admin

# Nom de la base MongoDB à utiliser
MONGO_DB_NAME=admin_db

# Secret de signature JWT, encodé en base64 (doit correspondre à celui du backend Spring Boot)
JWT_SECRET=

# URL de base du backend Spring Boot (pour les mises à jour de statut de demande)
BACKEND_BASE_URL=http://localhost:8083
